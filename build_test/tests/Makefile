	cd /home/runner/work/SymX/SymX/build_test && $(MAKE) $(MAKESILENT) -f tests/CMakeFiles/tests.dir/build.make tests/CMakeFiles/tests.dir/test_vector.cpp.s
.PHONY : test_vector.cpp.s

